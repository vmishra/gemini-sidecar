{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-gemini-4-argon[1m]",
  "apiKeyHelper": "cat ~/.config/gemini4/gateway-token",
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:3456",
    "CLAUDE_CODE_USE_VERTEX": "0",
    "CLAUDE_CODE_USE_BEDROCK": "0",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "ENABLE_TOOL_SEARCH": "false",
    "ANTHROPIC_MODEL": "claude-gemini-4-argon[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-gemini-4-argon[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-gemini-3.8-flash[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-gemini-3.5-flash-lite",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-gemini-3.8-flash[1m]",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"
  }
}
