# Gemini MCP server for OpenAI Codex CLI.
# Append this block to ~/.codex/config.toml (or run ./install.sh --codex, which appends it
# after making a backup). Replace the path with the absolute path to your clone.
#
# Credentials: set GEMINI_API_KEY in your shell, or uncomment the Vertex AI lines below.

[mcp_servers.gemini4]
command = "python3"
args = ["/absolute/path/to/gemini4-harness-kit/plugins/gemini/mcp/gemini4_mcp_server.py"]
startup_timeout_sec = 20
# Security audits and large refactors on gemini-4-argon can take several minutes.
tool_timeout_sec = 900

[mcp_servers.gemini4.env]
GEMINI4_PRIMARY_MODEL = "gemini-4-argon"
GEMINI4_SUBAGENT_MODEL = "gemini-3.8-flash"
GEMINI4_BACKGROUND_MODEL = "gemini-3.5-flash-lite"
# GOOGLE_GENAI_USE_VERTEXAI = "true"
# GOOGLE_CLOUD_PROJECT = "your-project-id"
# GOOGLE_CLOUD_LOCATION = "global"
