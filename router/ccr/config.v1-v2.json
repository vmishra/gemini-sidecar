{
  "LOG": true,
  "HOST": "127.0.0.1",
  "PORT": 3456,
  "API_TIMEOUT_MS": 1200000,
  "CUSTOM_ROUTER_PATH": "~/.claude-code-router/gemini4-cache-aware-router.js",
  "Providers": [
    {
      "name": "gemini",
      "api_base_url": "https://generativelanguage.googleapis.com/v1beta/models/",
      "api_key": "$GEMINI_API_KEY",
      "models": [
        "gemini-4-argon",
        "gemini-3.8-flash",
        "gemini-3.5-flash-lite"
      ],
      "transformer": {
        "use": ["gemini"]
      }
    },
    {
      "name": "anthropic",
      "api_base_url": "https://api.anthropic.com/v1/messages",
      "api_key": "$ANTHROPIC_UPSTREAM_KEY",
      "models": ["claude-opus-5-5", "claude-sonnet-5-5"]
    }
  ],
  "Router": {
    "default": "gemini,gemini-3.8-flash",
    "background": "gemini,gemini-3.5-flash-lite",
    "think": "gemini,gemini-4-argon",
    "longContext": "gemini,gemini-4-argon",
    "longContextThreshold": 150000
  }
}
